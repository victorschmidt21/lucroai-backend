# Ambiente da aplicação: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3100; o frontend usa a 3000)
PORT=3100

# Credenciais do Postgres usadas pelo docker-compose (valores fictícios, só para uso local)
POSTGRES_USER=lucroai
POSTGRES_PASSWORD=lucroai
POSTGRES_DB=lucroai
# Porta do Postgres exposta no host (padrão: 55440)
POSTGRES_PORT=55440

# [OBRIGATÓRIA] URL de conexão do Prisma.
# Use "localhost" ao rodar a API fora do Docker (npm run start:dev, testes).
# Dentro do docker-compose esse valor é sobrescrito para apontar ao serviço "postgres".
DATABASE_URL=postgresql://lucroai:lucroai@localhost:55440/lucroai?schema=public

# Segredo de assinatura dos tokens JWT.
# Opcional em development/test; obrigatório, com no mínimo 32 caracteres, nos demais ambientes.
# Valor fictício; gere um aleatório (ex.: openssl rand -base64 48) antes de publicar.
JWT_SECRET=exemplo-ficticio-substitua-por-segredo-aleatorio
