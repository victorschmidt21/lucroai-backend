// Schema único do monolito (BE-05). Junta os bancos dos 5 microsserviços com
// chaves estrangeiras reais. Tabelas e colunas mantêm os nomes de lá (snake_case).
// O módulo dono de cada model está no mapa de módulos do docs/architecture.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum UnidadeMedida {
  G
  KG
  ML
  L
  UN
}

/// Como o gasto entra no custo (BE-26): `MENSAL` é o valor do mês, dividido
/// pela capacidade mensal; `POR_UNIDADE` é reais por unidade vendida;
/// `PERCENTUAL_VENDA` é fração do preço (0 a 1).
enum TipoGasto {
  MENSAL
  POR_UNIDADE
  PERCENTUAL_VENDA
}

enum StatusVenda {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

/// Origem da movimentação de estoque de insumo.
enum OrigemMovimentacaoEstoque {
  COMPRA
  PRODUCAO
}

/// Origem da movimentação de produto acabado: entrada por produção, saída por venda.
enum OrigemMovimentacaoProdutoAcabado {
  PRODUCAO
  VENDA
}

/// Unidade da capacidade mensal da empresa (BE-24): fornadas ou minutos de forno.
enum BaseRateio {
  FORNADAS
  MINUTOS
}

// ---------- auth ----------

model Empresa {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(100)
  cnpj        String?  @unique @db.VarChar(18)
  segmento    String?  @db.VarChar(80)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuarios                    Usuario[]
  insumos                     Insumo[]
  estoques                    Estoque[]
  movimentacoesEstoque        MovimentacaoEstoque[]
  gastosIndiretos             GastoIndireto[]
  receitas                    Receita[]
  estoquesProdutoAcabado      EstoqueProdutoAcabado[]
  movimentacoesProdutoAcabado MovimentacaoProdutoAcabado[]
  producoes                   Producao[]
  vendas                      Venda[]
  configuracaoCustos          ConfiguracaoCustos?
  canaisVenda                 CanalVenda[]
  comprasInsumo               CompraInsumo[]

  @@map("empresa")
}

model Usuario {
  id          Int      @id @default(autoincrement())
  empresaId   Int      @map("empresa_id")
  nome        String?  @db.VarChar(80)
  email       String   @unique @db.VarChar(80)
  senha       String   @db.VarChar(255)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuario")
}

// ---------- insumos ----------

model Insumo {
  id                  Int           @id @default(autoincrement())
  empresaId           Int           @map("empresa_id")
  nome                String        @db.VarChar(80)
  quantidadeBaseCusto Float         @map("quantidade_base_custo")
  unidade             UnidadeMedida
  /// Último preço de referência (`valorPago` por `quantidadeBaseCusto`): o do
  /// cadastro, o da última compra ou o informado no PATCH
  valorPago           Float         @map("valor_pago")
  /// Custo médio móvel por unidade (BE-29): estoque, produção e venda
  custoMedio          Float         @map("custo_medio")
  /// Custo por unidade da última compra (BE-29)
  ultimoCusto         Float         @map("ultimo_custo")
  /// Preço de mercado por unidade, informado sem compra (BE-29); a próxima
  /// compra o limpa. Reposição = precoMercado ?? ultimoCusto
  precoMercado        Float?        @map("preco_mercado")
  precoMercadoData    DateTime?     @map("preco_mercado_data")
  dataCriacao         DateTime      @default(now()) @map("data_criacao")

  empresa       Empresa               @relation(fields: [empresaId], references: [id])
  estoque       Estoque?
  movimentacoes MovimentacaoEstoque[]
  itensReceita  ItemReceita[]
  compras       CompraInsumo[]

  @@index([empresaId])
  @@map("insumo")
}

/// Compra de insumo (BE-29), imutável. Dá entrada no estoque (ENTRADA/COMPRA,
/// `referenciaId` = id da compra) e recalcula o custo médio do insumo.
model CompraInsumo {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  insumoId      Int      @map("insumo_id")
  /// Na unidade do insumo; 0 só na compra inicial de um cadastro sem saldo
  quantidade    Float
  valorTotal    Float    @map("valor_total")
  /// Custo por unidade da compra: valorTotal / quantidade (na compra inicial,
  /// valorPago / quantidadeBaseCusto do cadastro)
  custoUnitario Float    @map("custo_unitario")
  observacao    String?  @db.VarChar(200)
  dataCompra    DateTime @default(now()) @map("data_compra")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([insumoId, dataCompra])
  @@map("compra_insumo")
}

// ---------- gastos-indiretos ----------

model GastoIndireto {
  id        Int       @id @default(autoincrement())
  empresaId Int       @map("empresa_id")
  descricao String    @db.VarChar(100)
  valor     Float
  tipo      TipoGasto

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("gasto_indireto")
}

// ---------- configuracao-custos ----------

/// Configuração de custos da empresa (BE-24): uma por empresa, criada com os
/// padrões no cadastro. As frações são do preço de venda (0 a 1).
model ConfiguracaoCustos {
  id                Int        @id @default(autoincrement())
  empresaId         Int        @unique @map("empresa_id")
  baseRateio        BaseRateio @default(FORNADAS) @map("base_rateio")
  capacidadeMensal  Float      @default(40) @map("capacidade_mensal")
  lucroPadrao       Float      @default(0.15) @map("lucro_padrao")
  impostoPercentual Float      @default(0) @map("imposto_percentual")
  taxaMaquininha    Float      @default(0) @map("taxa_maquininha")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("configuracao_custos")
}

// ---------- canais ----------

/// Canal de venda (BE-25): balcão, iFood etc. A comissão é fração do preço
/// (0 a 1). `balcao` marca o canal padrão, que não pode ser excluído.
model CanalVenda {
  id                 Int     @id @default(autoincrement())
  empresaId          Int     @map("empresa_id")
  nome               String
  comissaoPercentual Float   @map("comissao_percentual")
  ativo              Boolean @default(true)
  balcao             Boolean @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  vendas  Venda[]

  @@index([empresaId])
  @@map("canal_venda")
}

// ---------- receitas ----------

model Receita {
  id                  Int           @id @default(autoincrement())
  empresaId           Int           @map("empresa_id")
  nome                String        @db.VarChar(80)
  /// Unidades boas (vendáveis) por lote
  rendimento          Int
  unidadeRendimento   UnidadeMedida @map("unidade_rendimento")
  /// Fornadas ou minutos de forno de 1 lote, conforme a baseRateio da empresa
  usoPorLote          Float         @default(1) @map("uso_por_lote")
  /// Reais por unidade (caixa, pote ou saquinho do próprio produto)
  embalagemPorUnidade Float         @default(0) @map("embalagem_por_unidade")
  /// Fração das unidades que não são vendidas (0 ≤ perda < 1)
  perdaPercentual     Float         @default(0) @map("perda_percentual")
  /// Fração do preço; null usa o lucroPadrao da empresa
  lucroPercentual     Float?        @map("lucro_percentual")
  /// false: a receita só serve para usar dentro de outras (BE-39)
  vendavel            Boolean       @default(true)
  dataCriacao         DateTime      @default(now()) @map("data_criacao")

  empresa                     Empresa                      @relation(fields: [empresaId], references: [id])
  itens                       ItemReceita[]
  /// Receitas usadas dentro desta (BE-39)
  receitasUsadas              ItemReceitaReceita[]         @relation("ReceitaUsaReceita")
  /// Receitas que usam esta (BE-39)
  usadaEm                     ItemReceitaReceita[]         @relation("ReceitaUsadaEm")
  estoqueProdutoAcabado       EstoqueProdutoAcabado?
  movimentacoesProdutoAcabado MovimentacaoProdutoAcabado[]
  producoes                   Producao[]
  itensVenda                  ItemVenda[]

  @@index([empresaId])
  @@map("receita")
}

model ItemReceita {
  id         Int   @id @default(autoincrement())
  receitaId  Int   @map("receita_id")
  insumoId   Int   @map("insumo_id")
  quantidade Float

  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  /// RESTRICT: insumo usado em receita não pode ser excluído (409 INSUMO_EM_USO, BE-07)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([receitaId])
  @@index([insumoId])
  @@map("item_receita")
}

/// Receita usada dentro de outra (BE-39), um nível só. A quantidade fica na
/// unidade do rendimento da receita usada (`unidadeRendimento`).
model ItemReceitaReceita {
  id             Int   @id @default(autoincrement())
  receitaId      Int   @map("receita_id")
  receitaUsadaId Int   @map("receita_usada_id")
  quantidade     Float

  receita      Receita @relation("ReceitaUsaReceita", fields: [receitaId], references: [id], onDelete: Cascade)
  /// RESTRICT: receita usada em outra não pode ser excluída (409 RECEITA_EM_USO)
  receitaUsada Receita @relation("ReceitaUsadaEm", fields: [receitaUsadaId], references: [id], onDelete: Restrict)

  @@index([receitaId])
  @@index([receitaUsadaId])
  @@map("item_receita_receita")
}

// ---------- estoque ----------

/// Um saldo por insumo. Guarda o empresa_id para o módulo estoque conferir a empresa sem ler a tabela de insumos.
model Estoque {
  id                   Int       @id @default(autoincrement())
  empresaId            Int       @map("empresa_id")
  insumoId             Int       @unique @map("insumo_id")
  quantidadeDisponivel Float     @default(0) @map("quantidade_disponivel")
  quantidadeMinima     Float     @default(0) @map("quantidade_minima")
  dataAlteracao        DateTime? @updatedAt @map("data_alteracao")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("estoque")
}

model MovimentacaoEstoque {
  id               Int                       @id @default(autoincrement())
  empresaId        Int                       @map("empresa_id")
  insumoId         Int                       @map("insumo_id")
  tipo             TipoMovimentacaoEstoque
  origem           OrigemMovimentacaoEstoque
  quantidade       Float
  /// Id da produção (origem PRODUCAO) ou da compra (origem COMPRA, BE-29);
  /// nulo na entrada manual
  referenciaId     Int?                      @map("referencia_id")
  observacao       String?                   @db.VarChar(200)
  dataMovimentacao DateTime                  @default(now()) @map("data_movimentacao")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([insumoId, dataMovimentacao])
  @@map("movimentacao_estoque")
}

/// Um saldo de produto acabado por receita.
model EstoqueProdutoAcabado {
  id                   Int       @id @default(autoincrement())
  empresaId            Int       @map("empresa_id")
  receitaId            Int       @unique @map("receita_id")
  quantidadeDisponivel Float     @default(0) @map("quantidade_disponivel")
  dataAlteracao        DateTime? @updatedAt @map("data_alteracao")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("estoque_produto_acabado")
}

model MovimentacaoProdutoAcabado {
  id               Int                              @id @default(autoincrement())
  empresaId        Int                              @map("empresa_id")
  receitaId        Int                              @map("receita_id")
  tipo             TipoMovimentacaoEstoque
  origem           OrigemMovimentacaoProdutoAcabado
  quantidade       Float
  /// Id da produção (ENTRADA) ou da venda (SAIDA)
  referenciaId     Int?                             @map("referencia_id")
  dataMovimentacao DateTime                         @default(now()) @map("data_movimentacao")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([receitaId, dataMovimentacao])
  @@map("movimentacao_produto_acabado")
}

// ---------- producoes ----------

model Producao {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  receitaId     Int      @map("receita_id")
  /// Número de lotes produzidos
  quantidade    Int
  /// quantidade * receita.rendimento
  totalUnidades Int      @map("total_unidades")
  /// Insumos + rateio dos gastos indiretos
  custoTotal    Float?   @map("custo_total")
  /// custoTotal / totalUnidades
  custoUnitario Float?   @map("custo_unitario")
  dataProducao  DateTime @default(now()) @map("data_producao")

  empresa Empresa          @relation(fields: [empresaId], references: [id])
  /// RESTRICT: receita com produção não pode ser excluída
  receita Receita          @relation(fields: [receitaId], references: [id], onDelete: Restrict)
  rateios RateioProducao[]

  @@index([empresaId, receitaId])
  @@map("producao")
}

model RateioProducao {
  id              Int    @id @default(autoincrement())
  producaoId      Int    @map("producao_id")
  /// Sem FK (BE-12): o id fica mesmo depois de o gasto ser excluído, como nos
  /// microsserviços; o frontend espera um inteiro e mostra "Gasto #id"
  gastoIndiretoId Int    @map("gasto_indireto_id")
  /// Cópia da descrição do gasto na hora da produção
  descricao       String @db.VarChar(100)
  valorRateado    Float  @map("valor_rateado")

  producao Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)

  @@index([producaoId])
  @@index([gastoIndiretoId])
  @@map("rateio_producao")
}

// ---------- vendas ----------

model Venda {
  id        Int         @id @default(autoincrement())
  empresaId Int         @map("empresa_id")
  total     Float?
  status    StatusVenda @default(PENDENTE)
  dataVenda DateTime    @default(now()) @map("data_venda")
  /// Canal da venda (BE-30); null nas vendas antigas e depois de o canal ser excluído
  canalId   Int?        @map("canal_id")

  empresa Empresa     @relation(fields: [empresaId], references: [id])
  /// SET NULL: excluir o canal não apaga as vendas dele
  canal   CanalVenda? @relation(fields: [canalId], references: [id], onDelete: SetNull)
  itens   ItemVenda[]

  @@index([empresaId, dataVenda])
  @@index([canalId])
  @@map("venda")
}

model ItemVenda {
  id                Int    @id @default(autoincrement())
  vendaId           Int    @map("venda_id")
  receitaId         Int    @map("receita_id")
  quantidade        Int
  /// Preço efetivamente cobrado (pode diferir do precoSugerido)
  precoUnitarioReal Float  @map("preco_unitario_real")
  /// Cópia do custo unitário da receita na hora da venda
  custoUnitario     Float? @map("custo_unitario")
  /// (precoUnitarioReal - custoUnitario) / precoUnitarioReal, com round4
  margemRealizada   Float? @map("margem_realizada")
  /// 1 − percentuais do canal sem o lucro − custoUnitario ÷ precoUnitarioReal (BE-30)
  lucroReal         Float? @map("lucro_real")

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  /// RESTRICT: receita vendida não pode ser excluída
  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Restrict)

  @@index([vendaId])
  @@index([receitaId])
  @@map("item_venda")
}
